<% content_for(:title) do %>
  Account Observability
<% end %>

<header class="main-content__header" role="banner">
  <h1 class="main-content__page-title" id="page-title">
    <%= content_for(:title) %>: <%= @account.name %> (#<%= @account.id %>)
  </h1>

  <div>
    <%= link_to("Back to Account", [:super_admin, @account], class: "button") %>
  </div>
</header>

<section class="main-content__body">
  <h2>Summary</h2>
  <table>
    <tr>
      <th>Metric</th>
      <th>Value</th>
    </tr>
    <% @observability[:summary_metrics].each do |key, value| %>
      <tr>
        <td><%= key %></td>
        <td><%= value %></td>
      </tr>
    <% end %>
  </table>
</section>

<section class="main-content__body">
  <h2>Inbox Breakdown</h2>
  <table>
    <tr>
      <th>Inbox</th>
      <th>Channel</th>
      <th>Messages Total</th>
      <th>Messages 30d</th>
      <th>Webhook Backlog</th>
      <th>Webhook Failed</th>
    </tr>
    <% @observability[:inbox_breakdown].each do |row| %>
      <tr>
        <td><%= row[:name] %> (#<%= row[:id] %>)</td>
        <td><%= row[:channel_type] %></td>
        <td><%= row[:messages_total] %></td>
        <td><%= row[:messages_last_30_days] %></td>
        <td><%= row[:webhook_backlog] %></td>
        <td><%= row[:webhook_failed] %></td>
      </tr>
    <% end %>
  </table>
</section>

<section class="main-content__body">
  <h2>Monthly Growth</h2>
  <table>
    <tr>
      <th>Month</th>
      <th>Messages</th>
    </tr>
    <% @observability[:monthly_growth].each do |row| %>
      <tr>
        <td><%= row[:month] %></td>
        <td><%= row[:messages] %></td>
      </tr>
    <% end %>
  </table>
</section>

<section class="main-content__body">
  <h2>Recent Failed Webhook Events</h2>
  <table>
    <tr>
      <th>ID</th>
      <th>Source</th>
      <th>Event Type</th>
      <th>Inbox</th>
      <th>Updated At</th>
      <th>Error</th>
    </tr>
    <% @observability[:recent_failed_events].each do |event| %>
      <tr>
        <td><%= event.id %></td>
        <td><%= event.source %></td>
        <td><%= event.event_type %></td>
        <td><%= event.inbox_id %></td>
        <td><%= event.updated_at %></td>
        <td><%= event.error_message %></td>
      </tr>
    <% end %>
  </table>
</section>
